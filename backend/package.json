{
  "name": "leets-ag-backend",
  "version": "1.0.0",
  "description": "Backend API for Leets AG Asset Management",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:seed": "npm run db:seed-admin && npm run db:seed-demo",
    "db:seed-admin": "node src/scripts/seedAdmin.js",
    "db:seed-demo": "node src/scripts/seedDemo.js",
    "db:smoke": "node src/scripts/smokeDb.js",
    "test": "node --test"
  },
  "keywords": [
    "express",
    "postgresql",
    "pg",
    "asset-management",
    "api"
  ],
  "author": "Leets AG",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  }
}
